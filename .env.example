# Database Connection (Neon PostgreSQL)
# DATABASE_URL = Neon pooled connection string (with -pooler)
DATABASE_URL="postgresql://username:password@ep-sample-pooler.region.aws.neon.tech/jecrc_alumni?sslmode=require"
# DIRECT_URL = Neon direct connection string (for migrations)
DIRECT_URL="postgresql://username:password@ep-sample.region.aws.neon.tech/jecrc_alumni?sslmode=require"

# Server Configuration
PORT=5000
NODE_ENV=production
CLIENT_URL=https://jecrc-alumni-qr.onrender.com
PUBLIC_APP_URL=https://jecrc-alumni-qr.onrender.com
APP_BASE_URL=https://jecrc-alumni-qr.onrender.com
